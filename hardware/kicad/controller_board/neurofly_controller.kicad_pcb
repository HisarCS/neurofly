(kicad_pcb (version 20221018) (generator pcbnew)

  (general
    (thickness 1.6)
  )

  (paper "A4")

  (layers
    (0 "F.Cu" signal)
    (31 "B.Cu" signal)
    (36 "B.SilkS" user "B.Silkscreen")
    (37 "F.SilkS" user "F.Silkscreen")
    (38 "B.Mask" user)
    (39 "F.Mask" user)
    (44 "Edge.Cuts" user)
  )

  (net 0 "")
  (net 1 "GND")
  (net 2 "+3.3V")
  (net 3 "OLED_SDA")
  (net 4 "OLED_SCL")
  (net 5 "BTN_THR_UP")
  (net 6 "BTN_THR_DN")
  (net 7 "BTN_PITCH_UP")
  (net 8 "BTN_PITCH_DN")
  (net 9 "BTN_ARM")
  (net 10 "BTN_MODE")

  ;; Handheld Controller Outline (85mm x 60mm with rounded grip contours)
  (gr_rect (start -42.5 -30) (end 42.5 30) (layer "Edge.Cuts") (width 0.15))

  ;; 4 Corner Enclosure Mounting Holes (M2.5)
  (module "MountingHole:MountingHole_2.7mm_M2.5" (layer "F.Cu") (at -38 -25)
    (pad "1" np_thru_hole circle (at 0 0) (size 2.7 2.7) (drill 2.7) (layers *.Mask))
  )
  (module "MountingHole:MountingHole_2.7mm_M2.5" (layer "F.Cu") (at 38 -25)
    (pad "1" np_thru_hole circle (at 0 0) (size 2.7 2.7) (drill 2.7) (layers *.Mask))
  )
  (module "MountingHole:MountingHole_2.7mm_M2.5" (layer "F.Cu") (at 38 25)
    (pad "1" np_thru_hole circle (at 0 0) (size 2.7 2.7) (drill 2.7) (layers *.Mask))
  )
  (module "MountingHole:MountingHole_2.7mm_M2.5" (layer "F.Cu") (at -38 25)
    (pad "1" np_thru_hole circle (at 0 0) (size 2.7 2.7) (drill 2.7) (layers *.Mask))
  )

  ;; Silkscreen
  (gr_text "NeuroFly Transmitter v1.0" (at 0 -22) (layer "F.SilkS")
    (effects (font (size 1.2 1.2) (thickness 0.2)))
  )
  (gr_text "Hisar IdeaLab FabLab" (at 0 25) (layer "F.SilkS")
    (effects (font (size 1.0 1.0) (thickness 0.18)))
  )

  ;; OLED 0.96" Header (4 pins: GND, VCC, SCL, SDA)
  (module "Connector_PinHeader_2.54mm:PinHeader_1x04_P2.54mm_Vertical" (layer "F.Cu") (at 0 -8)
    (pad "1" thru_hole rect (at -3.81 0) (size 1.7 1.7) (drill 1.0) (layers *.Cu *.Mask) (net 1 "GND"))
    (pad "2" thru_hole circle (at -1.27 0) (size 1.7 1.7) (drill 1.0) (layers *.Cu *.Mask) (net 2 "+3.3V"))
    (pad "3" thru_hole circle (at 1.27 0) (size 1.7 1.7) (drill 1.0) (layers *.Cu *.Mask) (net 4 "OLED_SCL"))
    (pad "4" thru_hole circle (at 3.81 0) (size 1.7 1.7) (drill 1.0) (layers *.Cu *.Mask) (net 3 "OLED_SDA"))
  )

  ;; Left D-Pad Controls (Throttle Up/Down)
  (module "Button_Switch_SMD:SW_SPST_PTS645" (layer "F.Cu") (at -25 0)
    (pad "1" smd rect (at -3.25 0) (size 1.5 2.0) (layers "F.Cu" "F.Paste" "F.Mask") (net 5 "BTN_THR_UP"))
    (pad "2" smd rect (at 3.25 0) (size 1.5 2.0) (layers "F.Cu" "F.Paste" "F.Mask") (net 1 "GND"))
  )
  (module "Button_Switch_SMD:SW_SPST_PTS645" (layer "F.Cu") (at -25 14)
    (pad "1" smd rect (at -3.25 0) (size 1.5 2.0) (layers "F.Cu" "F.Paste" "F.Mask") (net 6 "BTN_THR_DN"))
    (pad "2" smd rect (at 3.25 0) (size 1.5 2.0) (layers "F.Cu" "F.Paste" "F.Mask") (net 1 "GND"))
  )

  ;; Right D-Pad Controls (Pitch Up/Down)
  (module "Button_Switch_SMD:SW_SPST_PTS645" (layer "F.Cu") (at 25 0)
    (pad "1" smd rect (at -3.25 0) (size 1.5 2.0) (layers "F.Cu" "F.Paste" "F.Mask") (net 7 "BTN_PITCH_UP"))
    (pad "2" smd rect (at 3.25 0) (size 1.5 2.0) (layers "F.Cu" "F.Paste" "F.Mask") (net 1 "GND"))
  )
  (module "Button_Switch_SMD:SW_SPST_PTS645" (layer "F.Cu") (at 25 14)
    (pad "1" smd rect (at -3.25 0) (size 1.5 2.0) (layers "F.Cu" "F.Paste" "F.Mask") (net 8 "BTN_PITCH_DN"))
    (pad "2" smd rect (at 3.25 0) (size 1.5 2.0) (layers "F.Cu" "F.Paste" "F.Mask") (net 1 "GND"))
  )
)
