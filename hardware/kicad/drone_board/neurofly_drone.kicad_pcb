(kicad_pcb (version 20221018) (generator pcbnew)

  (general
    (thickness 1.2)
  )

  (paper "A4")

  (layers
    (0 "F.Cu" signal)
    (31 "B.Cu" signal)
    (32 "B.Adhes" user "B.Adhesive")
    (33 "F.Adhes" user "F.Adhesive")
    (34 "B.Paste" user)
    (35 "F.Paste" user)
    (36 "B.SilkS" user "B.Silkscreen")
    (37 "F.SilkS" user "F.Silkscreen")
    (38 "B.Mask" user)
    (39 "F.Mask" user)
    (40 "Dwgs.User" user "User.Drawings")
    (41 "Cmts.User" user "User.Comments")
    (42 "Eco1.User" user "User.Eco1")
    (43 "Eco2.User" user "User.Eco2")
    (44 "Edge.Cuts" user)
    (45 "Margin" user)
    (46 "B.CrtYd" user "B.Courtyard")
    (47 "F.CrtYd" user "F.Courtyard")
    (48 "B.Fab" user)
    (49 "F.Fab" user)
  )

  (setup
    (pad_to_mask_clearance 0.05)
    (pcbplotparams
      (layerselection 0x00010fc_ffffffff)
      (plot_on_all_layers_selection 0x0000000_00000000)
      (disableapertmacros false)
      (usegerberextensions true)
      (usegerberattributes true)
      (usegerberadvancedattributes true)
      (creategerberjobfile true)
      (svgprecision 4)
      (plotframeref false)
      (viasonmask false)
      (mode 1)
      (useauxorigin false)
      (hpglpennumber 1)
      (hpglpenspeed 20)
      (hpglpendiameter 15.000000)
      (dxfopts 0)
      (pdfopts 0)
    )
  )

  (net 0 "")
  (net 1 "GND")
  (net 2 "+3.7V")
  (net 3 "+3.3V")
  (net 4 "PWM_FL")
  (net 5 "PWM_FR")
  (net 6 "PWM_RR")
  (net 7 "PWM_RL")
  (net 8 "I2C_SDA")
  (net 9 "I2C_SCL")
  (net 10 "BAT_ADC")
  (net 11 "STATUS_LED")

  ;; Board Outline (36mm x 36mm with rounded corners)
  (gr_rect (start -18 -18) (end 18 18) (layer "Edge.Cuts") (width 0.15))

  ;; Lightweight Center Cutout (12mm x 12mm) to reduce AUW mass
  (gr_rect (start -6 -6) (end 6 6) (layer "Edge.Cuts") (width 0.15))

  ;; Standard Flight Controller M2 Mounting Holes (30.5mm x 30.5mm pattern)
  (module "MountingHole:MountingHole_2.2mm_M2" (layer "F.Cu") (at -15.25 -15.25)
    (pad "1" np_thru_hole circle (at 0 0) (size 2.2 2.2) (drill 2.2) (layers *.Mask))
  )
  (module "MountingHole:MountingHole_2.2mm_M2" (layer "F.Cu") (at 15.25 -15.25)
    (pad "1" np_thru_hole circle (at 0 0) (size 2.2 2.2) (drill 2.2) (layers *.Mask))
  )
  (module "MountingHole:MountingHole_2.2mm_M2" (layer "F.Cu") (at 15.25 15.25)
    (pad "1" np_thru_hole circle (at 0 0) (size 2.2 2.2) (drill 2.2) (layers *.Mask))
  )
  (module "MountingHole:MountingHole_2.2mm_M2" (layer "F.Cu") (at -15.25 15.25)
    (pad "1" np_thru_hole circle (at 0 0) (size 2.2 2.2) (drill 2.2) (layers *.Mask))
  )

  ;; Silkscreen Branding
  (gr_text "NeuroFly v1.0" (at 0 -15.5) (layer "F.SilkS")
    (effects (font (size 1.2 1.2) (thickness 0.2)))
  )
  (gr_text "Hisar IdeaLab" (at 0 15.5) (layer "F.SilkS")
    (effects (font (size 1.0 1.0) (thickness 0.18)))
  )
  (gr_text "M1-FL" (at -14 -10) (layer "F.SilkS") (effects (font (size 0.8 0.8) (thickness 0.15))))
  (gr_text "M2-FR" (at 14 -10) (layer "F.SilkS") (effects (font (size 0.8 0.8) (thickness 0.15))))
  (gr_text "M3-RR" (at 14 10) (layer "F.SilkS") (effects (font (size 0.8 0.8) (thickness 0.15))))
  (gr_text "M4-RL" (at -14 10) (layer "F.SilkS") (effects (font (size 0.8 0.8) (thickness 0.15))))

  ;; Motor Solder Pads (Corners)
  ;; M1 Front-Left
  (module "Connector_PinHeader_2.54mm:PinHeader_1x02_P2.54mm_Vertical" (layer "F.Cu") (at -12 -12)
    (pad "1" thru_hole rect (at 0 -1.27) (size 1.8 1.8) (drill 1.0) (layers *.Cu *.Mask) (net 2 "+3.7V"))
    (pad "2" thru_hole circle (at 0 1.27) (size 1.8 1.8) (drill 1.0) (layers *.Cu *.Mask))
  )
  ;; M2 Front-Right
  (module "Connector_PinHeader_2.54mm:PinHeader_1x02_P2.54mm_Vertical" (layer "F.Cu") (at 12 -12)
    (pad "1" thru_hole rect (at 0 -1.27) (size 1.8 1.8) (drill 1.0) (layers *.Cu *.Mask) (net 2 "+3.7V"))
    (pad "2" thru_hole circle (at 0 1.27) (size 1.8 1.8) (drill 1.0) (layers *.Cu *.Mask))
  )
  ;; M3 Rear-Right
  (module "Connector_PinHeader_2.54mm:PinHeader_1x02_P2.54mm_Vertical" (layer "F.Cu") (at 12 12)
    (pad "1" thru_hole rect (at 0 -1.27) (size 1.8 1.8) (drill 1.0) (layers *.Cu *.Mask) (net 2 "+3.7V"))
    (pad "2" thru_hole circle (at 0 1.27) (size 1.8 1.8) (drill 1.0) (layers *.Cu *.Mask))
  )
  ;; M4 Rear-Left
  (module "Connector_PinHeader_2.54mm:PinHeader_1x02_P2.54mm_Vertical" (layer "F.Cu") (at -12 12)
    (pad "1" thru_hole rect (at 0 -1.27) (size 1.8 1.8) (drill 1.0) (layers *.Cu *.Mask) (net 2 "+3.7V"))
    (pad "2" thru_hole circle (at 0 1.27) (size 1.8 1.8) (drill 1.0) (layers *.Cu *.Mask))
  )

  ;; Battery Input Pad (JST-PH 2.0 / BT2.0)
  (module "Connector_JST:JST_PH_S2B-PH-K_1x02_P2.00mm_Horizontal" (layer "F.Cu") (at 0 12)
    (pad "1" thru_hole roundrect (at -1 0) (size 1.6 1.6) (drill 0.9) (layers *.Cu *.Mask) (roundrect_rratio 0.25) (net 2 "+3.7V"))
    (pad "2" thru_hole circle (at 1 0) (size 1.6 1.6) (drill 0.9) (layers *.Cu *.Mask) (net 1 "GND"))
  )
)
